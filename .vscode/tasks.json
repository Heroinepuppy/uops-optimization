
    
  
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake -S . -B build -G \"Visual Studio 18 2026\" -A x64",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "cmake --build build --config Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake Configure",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run uop benchmark",
      "type": "shell",
      "command": ".\\build\\Release\\lidar_uop_benchmark.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run threading benchmark",
      "type": "shell",
      "command": ".\\build\\Release\\lidar_thread_scaling.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Run uop benchmark",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build and run CPU benchmarks",
      "type": "shell",
      "command": "Write-Host 'CPU benchmarks complete.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Run threading benchmark",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GPU: Build",
      "type": "shell",
      "command": "mkdir \"build\\gpu\" 2>nul & call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" -vcvars_ver=14.44 && \"C:\\Program Files\\AMD\\ROCm\\7.2\\bin\\hipcc.exe\" --offload-arch=gfx1100 -O3 -std=c++20 .\\lidar_gpu_benchmark.cpp -o .\\build\\gpu\\lidar_gpu_benchmark.exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: Run",
      "type": "shell",
      "command": ".\\build\\gpu\\lidar_gpu_benchmark.exe 200 256",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "dependsOn": "GPU: Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}