{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "shared",
    "echo": true
  },
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DLIDAR_REQUIRE_ARMV8=OFF -DLIDAR_BUILD_GPU=AUTO && cmake --build build --parallel",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash",
          "args": [
            "-c"
          ]
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DLIDAR_REQUIRE_ARMV8=OFF -DLIDAR_BUILD_GPU=AUTO && cmake --build build --parallel",
        "options": {
          "shell": {
            "executable": "cmd.exe",
            "args": [
              "/d",
              "/c"
            ]
          }
        }
      }
    },
    {
      "label": "Run CPU",
      "type": "process",
      "command": "${workspaceFolder}/build/bin/lidar_compute_cpu",
      "args": [
        "--points",
        "125",
        "--transforms",
        "1,8",
        "--verify-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/build/bin/lidar_compute_cpu.exe"
      }
    },
    {
      "label": "Run GPU",
      "type": "process",
      "command": "${workspaceFolder}/build/bin/lidar_compute_gpu",
      "args": [
        "--points",
        "125",
        "--transforms",
        "1,8",
        "--verify-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/build/bin/lidar_compute_gpu.exe"
      }
    },
    {
      "label": "Analyse",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-E",
        "analysis/run_analysis.py",
        "--plots",
        "comparison",
        "cpu-gpu",
        "fits",
        "histogram-matrix",
        "runtime-by-points"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Run benchmark matrix",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "benchmarks/run_all_benchmarks.py",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "label": "Run hardware info",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "benchmarks/hardware_info.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      }
    },
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Run ARMv8",
      "command": "${workspaceFolder}/build/bin/ARMv8/lidar_compute_cpu",
      "args": [
        "--points",
        "125",
        "--transforms",
        "1,8,1024",
        "--method",
        "all",
        "--verify-only"
      ],
      "dependsOn": "Build"
    }
  ]
}
