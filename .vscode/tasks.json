{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Plot CPU vs GPU results",
      "type": "shell",
      "command": "python .\\plot_cpu_gpu.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake Configure",
      "type": "process",
      "command": "${env:ProgramFiles}\\Microsoft Visual Studio\\18\\Community\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe",
      "args": [
        "-S",
        ".",
        "-B",
        "build/vs2026",
        "-G",
        "Visual Studio 18 2026",
        "-A",
        "x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Release",
      "type": "process",
      "command": "${env:ProgramFiles}\\Microsoft Visual Studio\\18\\Community\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe",
      "args": [
        "--build",
        "build/vs2026",
        "--config",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake Configure",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run uop benchmark",
      "type": "shell",
      "command": ".\\build\\vs2026\\Release\\lidar_uop_benchmark.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run threading benchmark",
      "type": "shell",
      "command": ".\\build\\vs2026\\Release\\lidar_thread_scaling.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Run uop benchmark",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build and run CPU benchmarks",
      "type": "shell",
      "command": "Write-Host 'CPU benchmarks complete.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Run threading benchmark",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GPU: Build",
      "type": "shell",
      "command": "mkdir \"build\\gpu\" 2>nul & call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" -vcvars_ver=14.44 && \"C:\\Program Files\\AMD\\ROCm\\7.2\\bin\\hipcc.exe\" --offload-arch=gfx1100 -O3 -std=c++20 .\\lidar_gpu_benchmark.cpp -o .\\build\\gpu\\lidar_gpu_benchmark.exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "GPU: Run",
      "type": "shell",
      "command": ".\\build\\gpu\\lidar_gpu_benchmark.exe 200 256",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "dependsOn": "GPU: Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Compute: Build GPU",
      "type": "shell",
      "command": ".\\build_compute_gpu.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Compute: Run CPU vs GPU sweep",
      "type": "shell",
      "command": "python .\\run_compute_benchmark.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build Release",
        "Compute: Build GPU"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Compute: Plot saved results",
      "type": "shell",
      "command": "python .\\run_compute_benchmark.py --plot-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
