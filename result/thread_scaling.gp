set term pngcairo size 3200,2000 enhanced font 'Segoe UI,8'
set output 'D:/GIT/uops/result/thread_scaling.png'
reset
set origin 0,0
set size 1,1
set multiplot layout 4,5 rowsfirst title 'LiDAR CPU Benchmark - Laufzeitverteilungen' font ',14'
set style fill solid 0.70 border -1
set boxwidth 0.90 relative
set grid ytics
set key off
set title '200k - 1 Thread'
set xlabel 'us pro komplette Cloud'
set ylabel 'Anzahl Messbloecke'
set xrange [0:*]
set yrange [0:*]
plot $H0 using 1:2 with boxes
